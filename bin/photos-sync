#!/usr/bin/env bash
# Two-way sync of the photo library with the server, then tell the server what the Mac has.
# Never deletes on either side: remove a photo locally AND on the server, or it comes back.
# usage: WILLCROCK_REMOTE=user@host bin/photos-sync [--dry-run]
set -euo pipefail

remote="${WILLCROCK_REMOTE:?set WILLCROCK_REMOTE=user@host}"
local_dir="${PHOTOS_LOCAL:-$HOME/willcrock.com/photos}"
remote_dir="${PHOTOS_REMOTE:-data/willcrock.com/photos}"
fcgi='willcrock.com/willcrock.fcgi' # relative to the remote home dir

dry=()
[ "${1:-}" = "--dry-run" ] && dry=(-n)

mkdir -p "$local_dir"
rsync_opts=(-a --itemize-changes --exclude '.*' "${dry[@]}")

echo "== pull"
rsync "${rsync_opts[@]}" "$remote:$remote_dir/" "$local_dir/"
echo "== push"
rsync "${rsync_opts[@]}" "$local_dir/" "$remote:$remote_dir/"

if [ "${#dry[@]}" -gt 0 ]; then
  echo "dry run: skipped scan and mark-synced"
  exit 0
fi

echo "== scan"
ssh "$remote" "$fcgi photos scan"
echo "== mark-synced"
(cd "$local_dir" && find . -type f ! -name '.*' -exec stat -f '%N%t%z%t%m' {} + | sed 's|^\./||') |
  ssh "$remote" "$fcgi photos mark-synced"
