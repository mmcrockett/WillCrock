#!/usr/bin/env bash
# Two-way sync of the photo library with the server, then tell the server what the Mac has.
# Never deletes on either side: remove a photo locally AND on the server, or it comes back.
set -euo pipefail

usage() {
  echo "usage: bin/photos-sync --login user@host --local-dir DIR" >&2
  exit 1
}

login=""
local_dir=""
while [ $# -gt 0 ]; do
  case "$1" in
    --login) login="${2:?--login needs user@host}"; shift 2 ;;
    --local-dir) local_dir="${2:?--local-dir needs a path}"; shift 2 ;;
    *) usage ;;
  esac
done
[ -n "$login" ] && [ -n "$local_dir" ] || usage

remote_dir="data/willcrock.com/photos"
fcgi="willcrock.com/willcrock.fcgi" # relative to the remote home dir

mkdir -p "$local_dir"
rsync_opts=(-a --itemize-changes --exclude '.*')

# One authenticated master connection, so the password is asked once per run.
ctl_dir="$(mktemp -d)"
ssh_opts=(-o "ControlPath=$ctl_dir/ctl")
trap 'ssh "${ssh_opts[@]}" -O exit "$login" 2>/dev/null || true; rm -rf "$ctl_dir"' EXIT
ssh "${ssh_opts[@]}" -o ControlMaster=yes -fN "$login"

echo "== pull"
rsync -e "ssh ${ssh_opts[*]}" "${rsync_opts[@]}" "$login:$remote_dir/" "$local_dir/"
echo "== push"
rsync -e "ssh ${ssh_opts[*]}" "${rsync_opts[@]}" "$local_dir/" "$login:$remote_dir/"
echo "== scan"
ssh "${ssh_opts[@]}" "$login" "$fcgi photos scan"
echo "== mark-synced"
if stat --version >/dev/null 2>&1; then
  stat_fmt=(--printf '%n\t%s\t%Y\n') # GNU coreutils
else
  stat_fmt=(-f '%N%t%z%t%m') # BSD
fi
(cd "$local_dir" && find . -type f ! -name '.*' -exec stat "${stat_fmt[@]}" {} + | sed 's|^\./||') |
  ssh "${ssh_opts[@]}" "$login" "$fcgi photos mark-synced"
